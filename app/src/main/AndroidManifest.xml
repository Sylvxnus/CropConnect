<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.CAMERA"/>

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false"/>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CropConnect"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="31">

        <!-- Main flow -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Auth -->
        <activity android:name=".activities.LoginActivity"
            android:exported="false"/>
        <activity android:name=".activities.RegisterActivity"
            android:exported="false"/>

        <!-- Guest -->
        <activity android:name=".activities.guest.Maps"
            android:exported="false"/>
        <activity android:name=".activities.guest.FoodBankDetailsEngine"
            android:exported="false"/>

        <!-- Producer -->
        <activity android:name=".activities.producer.ProducerEntryActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity"/>
        <activity android:name=".activities.producer.ProducerLoginActivity"
            android:exported="false"
            android:parentActivityName=".activities.producer.ProducerEntryActivity"/>
        <activity android:name=".activities.producer.ProducerRegisterActivity"
            android:exported="false"
            android:parentActivityName=".activities.producer.ProducerEntryActivity"/>
        <activity android:name=".activities.producer.PROD_Dashboard"
            android:exported="false"/>
        <activity android:name=".activities.producer.WeatherAdvice"
            android:exported="false"/>
        <activity android:name=".activities.producer.ProcessDonations"
            android:exported="false"/>
        <activity android:name=".activities.producer.ProcessCredits"
            android:exported="false"/>

        <!-- Food Bank -->
        <activity android:name=".activities.foodbank.FB_Dashboard"
            android:exported="false"/>
        <activity android:name=".activities.foodbank.FoodBankLoginActivity"
            android:exported="false"/>
        <activity android:name=".activities.foodbank.FoodBankDonationsActivity"
            android:exported="false"/>
        <activity android:name=".activities.foodbank.FoodBankProcessDonations"
            android:exported="false"/>
        <activity android:name=".activities.foodbank.ViewStock"
            android:exported="false"
            android:parentActivityName=".activities.foodbank.FB_Dashboard"/>
        <activity android:name=".activities.foodbank.AlterStock"
            android:exported="false"
            android:parentActivityName=".activities.foodbank.ViewStock"/>

    </application>

</manifest>